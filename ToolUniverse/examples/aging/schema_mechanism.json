  {
    "name": "AgingPathway",
    "type": "AgingPathwayTool",
    "description": "Offline gene-set enrichment: hypergeometric ORA with an explicit tested background, GSEApy preranked permutation GSEA, or mean log-normalized expression scoring with coverage reports. Supply local gene sets and their source/version.",
    "parameter": {
      "type": "object",
      "properties": {
        "request": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "run_overrepresentation"
                  ]
                },
                "output_dir": {
                  "type": "string",
                  "minLength": 1
                },
                "gene_sets": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "gmt_path": {
                  "type": "string",
                  "minLength": 1
                },
                "gene_set_source": {
                  "type": "string",
                  "minLength": 1,
                  "description": "User-supplied library name/version or DOI; no runtime download."
                },
                "selected_genes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "background_genes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "operation",
                "output_dir",
                "selected_genes",
                "background_genes",
                "gene_set_source"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "gene_sets"
                  ],
                  "not": {
                    "required": [
                      "gmt_path"
                    ]
                  }
                },
                {
                  "required": [
                    "gmt_path"
                  ],
                  "not": {
                    "required": [
                      "gene_sets"
                    ]
                  }
                }
              ]
            },
            {
