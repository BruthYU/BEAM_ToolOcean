  {
    "name": "AgingDifferentialExpression",
    "type": "AgingDifferentialExpressionTool",
    "description": "Donor-level PyDESeq2 negative-binomial Wald contrasts on raw bulk or pseudobulk counts. Unpaired analyses require one sample per donor; paired analyses require one sample per donor per condition. Test one cell type at a time. Missing p-values remain missing, not significant.",
    "parameter": {
      "type": "object",
      "properties": {
        "request": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "compare_groups"
                  ]
                },
                "output_dir": {
                  "type": "string",
                  "minLength": 1
                },
                "input_path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Observations x genes CSV (first column is observation ID) or h5ad."
                },
                "metadata_path": {
                  "type": "string",
                  "minLength": 1
                },
                "sample_key": {
                  "type": "string",
                  "minLength": 1,
                  "default": "sample_id"
                },
                "layer": {
                  "type": "string",
                  "minLength": 1
                },
                "max_dense_elements": {
                  "type": "integer",
                  "default": 25000000,
                  "minimum": 1,
                  "maximum": 100000000
                },
                "expression_scale": {
                  "type": "string",
                  "enum": [
                    "counts"
                  ]
                },
                "donor_key": {
                  "type": "string",
                  "minLength": 1,
                  "default": "donor_id"
                },
                "covariates": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "categorical_covariates": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "min_total_count": {
                  "type": "integer",
                  "default": 10,
                  "minimum": 0
                },
                "n_cpus": {
                  "type": "integer",
                  "default": 1,
                  "minimum": 1,
                  "maximum": 32
                },
                "alpha": {
                  "type": "number",
                  "default": 0.05,
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "group_key": {
                  "type": "string",
                  "minLength": 1,
                  "default": "group"
                },
                "compare_groups": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "uniqueItems": true,
                  "description": "Reference level first; test level second. Input must contain exactly these groups."
                },
                "cell_type": {
