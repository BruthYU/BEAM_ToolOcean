[
  {
    "name": "RNAAgeCalc",
    "type": "RNAAgeCalcTool",
    "description": "Predict human bulk RNA age using official RNAAgeCalc coefficients. Complete signature coverage is required; no imputation or automatic ID mapping. Counts require explicit gene lengths. Does not infer longevity or aging speed.",
    "parameter": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "properties": {
            "input_path": {
              "type": "string",
              "description": "h5ad or observations-by-genes CSV; first CSV column contains observation IDs."
            },
            "output_dir": {
              "type": "string",
              "description": ""
            },
            "model_dir": {
              "type": "string",
              "description": "Locally deployed, checksum-verified official model bundle directory."
            },
            "species": {
              "type": "string",
              "enum": [
                "human"
              ]
            },
            "layer": {
              "type": "string",
              "description": ""
            },
            "metadata_columns": {
              "type": "array",
              "items": {
                "type": "string",
                "description": ""
              },
              "uniqueItems": true
            },
            "operation": {
              "type": "string",
              "enum": [
                "predict_age"
              ]
            },
            "expression_type": {
              "type": "string",
              "enum": [
                "FPKM",
                "counts"
              ]
            },
            "gene_id_type": {
              "type": "string",
              "enum": [
                "SYMBOL"
              ]
            },
            "gene_length_key": {
              "type": "string",
              "description": "Positive gene lengths in base pairs in h5ad var; required for counts."
            },
            "tissue": {
              "type": "string",
              "description": "Must exactly match the fixed model bundle tissue, e.g. all_tissues."
            },
            "data_kind": {
              "type": "string",
              "enum": [
                "bulk"
              ]
            }
          },
          "required": [
            "operation",
            "input_path",
            "output_dir",
            "model_dir",
            "species",
            "expression_type",
            "gene_id_type",
            "tissue",
            "data_kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "predict_age"
          ]
        },
        "predictions": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "shape": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "axes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "path",
            "shape"
          ],
          "additionalProperties": false
        },
        "backend": {
          "type": "string"
        },
        "model": {
          "type": "object"
        },
        "device": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "provenance": {
          "type": "object"
        },
        "coverage": {
          "type": "object",
          "properties": {
            "required_genes": {
              "type": "integer",
              "minimum": 1
            },
            "matched_genes": {
              "type": "integer",
              "minimum": 0
            },
            "coverage_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "missing_genes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "required_genes",
            "matched_genes",
            "coverage_fraction",
            "missing_genes"
          ],
          "additionalProperties": false
        },
        "age_unit": {
          "const": "years"
        }
      },
      "required": [
        "operation",
        "predictions",
        "backend",
        "model",
        "device",
        "coverage"
      ],
      "additionalProperties": false
    }
