[
  {
    "name": "perturbation_load_dataset",
    "type": "PerturbationDatasetTool",
    "description": "Load local expression data from H5AD, modern 10x H5, 10x MTX directories, or numeric CSV/TSV (including gzip). Validate IDs and metadata joins and write a persistent reference with fingerprints for every input. Returns a JSON summary, not the full matrix. Does not normalize or predict. CSV/TSV requires explicit matrix_orientation and index_column.",
    "parameter": {
      "type": "object",
      "required": [
        "source",
        "output_dir"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Local expression file or 10x MTX directory. MTX directory must directly contain matrix, features/genes and barcodes files.",
          "minLength": 1
        },
        "output_dir": {
          "type": "string",
          "description": "Directory for persistent dataset references.",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "description": "Optional unique dataset name; generated when omitted."
        },
        "format": {
          "type": "string",
          "enum": [
            "auto",
            "h5ad",
            "10x_h5",
            "10x_mtx",
            "csv",
            "tsv"
          ],
          "default": "auto",
          "description": "auto detects H5AD, modern 10x H5, 10x MTX directory or CSV/TSV (optionally gzip)."
        },
        "matrix_key": {
          "type": "string",
          "description": "Expression matrix: X (default), raw/X or layers/<name>.",
          "minLength": 1
        },
        "gene_id_column": {
          "type": "string",
          "description": "Variable annotation column containing unique gene IDs; default variable index.",
          "minLength": 1
        },
        "obs_column_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Standard observation fields mapped to existing original columns."
        },
        "control_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Control labels; requires obs_column_map.perturbation."
        },
        "expression_scale": {
          "type": "string",
          "enum": [
            "counts",
            "normalized",
            "log1p",
            "unknown"
          ],
          "default": "unknown",
          "description": "Caller-declared expression scale; no normalization is performed."
        },
        "backed": {
          "type": "boolean",
          "description": "Read H5AD using backed mode. Layers can still be materialized by AnnData."
        },
        "integrity_check": {
          "type": "string",
          "enum": ["sha256", "stat"],
          "default": "sha256",
          "description": "sha256 hashes each input once at load and again on reference resolution. stat uses size, modification/change timestamps, device and inode without reading full input contents."
        },
        "metadata_path": {
          "type": "string",
          "description": "Optional CSV, TSV or Parquet metadata file.",
          "minLength": 1
        },
        "metadata_join_keys": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data",
            "metadata"
          ],
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "metadata": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "description": "Equal-length join key lists; data key __obs_index__ refers to observation IDs."
        },
        "metadata_match": {
          "type": "string",
          "enum": [
            "strict",
            "allow_missing"
          ],
          "default": "strict",
          "description": "Whether missing metadata matches fail or produce a counted warning."
        },
        "matrix_orientation": {
          "type": "string",
          "enum": [
            "observations_by_features",
            "features_by_observations"
          ],
          "description": "Required for CSV/TSV. Orientation of the input table; output always uses observations by features."
        },
        "index_column": {
          "type": "string",
          "minLength": 1,
          "description": "Required for CSV/TSV. Exact header name of the column holding row IDs. Remaining columns must all be numeric expression values."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "data",
            "warnings"
          ],
          "properties": {
            "status": {
              "const": "success"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "data": {
              "type": "object",
              "required": [
                "dataset_ref",
                "dataset_id",
                "modality",
                "format",
                "shape",
                "dtype",
                "matrix_key",
                "orientation",
                "expression_scale",
                "metadata_fields"
              ],
              "properties": {
                "dataset_ref": {
                  "type": "string"
                },
                "dataset_id": {
                  "type": "string"
                },
                "modality": {
                  "const": "expression"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "h5ad",
                    "10x_h5",
                    "10x_mtx",
                    "csv",
                    "tsv"
                  ]
                },
                "integrity_check": {
                  "type": "string",
                  "enum": ["sha256", "stat"]
                },
                "shape": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "dtype": {
                  "type": "string"
                },
                "matrix_key": {
                  "type": "string"
                },
                "orientation": {
                  "const": "observations_by_features"
                },
                "expression_scale": {
                  "type": "string"
                },
                "metadata_fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "n_controls": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "error_code"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "type": "string"
            },
            "error_code": {
              "type": "string"
            }
          }
        }
      ]
    },
    "requires_local_input": true,
    "required_packages": [
      "anndata"
    ],
    "cacheable": false,
    "test_examples": [
      {
        "source": "perturb_tools/test_data/real/molecular/adamson_2016.h5ad",
        "output_dir": "/tmp/perturbation-example-workspace"
      }
    ],
    "aliases": [
      "perturbation.load_dataset"
    ]
  },
  {
    "name": "perturbation_load_metadata",
    "aliases": [
      "perturbation.load_metadata"
    ],
    "type": "PerturbationMetadataTool",
    "description": "Load and standardize perturbation experiment annotations for expression or image experiments: perturbation labels, doses, times, controls, repeats and batches. Validate explicit experiment-level association keys and control annotations; return standardized metadata reference, summary and bounded actual-record preview. Use for perturbation semantics, not generic table reading. Does not guess units or controls, attach to or modify datasets, infer mechanism, or assess full experimental design.",
    "parameter": {
      "type": "object",
      "required": [
        "source",
        "output_dir",
        "experiment_level",
        "field_map",
        "association_keys"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Local perturbation experiment metadata table or H5AD whose obs is read without loading expression matrices."
        },
        "output_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Directory for standardized JSONL and persistent metadata reference."
        },
        "experiment_level": {
          "type": "string",
          "enum": [
            "cell",
            "sample",
            "well",
            "field"
          ],
          "description": "One row per cell, sample, well or image field; level IDs are required and must be part of association_keys."
        },
        "field_map": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "perturbation",
              "perturbation_type",
              "cell_id",
              "sample_id",
              "plate_id",
              "well_id",
              "site_id",
              "cell_type",
              "dose",
              "dose_unit",
              "time",
              "time_unit",
              "batch",
              "replicate",
              "is_control"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Standard field to original column. perturbation and level IDs must be mapped or supplied as constants. H5AD observation IDs are exposed as __obs_index__."
        },
        "association_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "perturbation",
              "perturbation_type",
              "cell_id",
              "sample_id",
              "plate_id",
              "well_id",
              "site_id",
              "cell_type",
              "dose",
              "dose_unit",
              "time",
              "time_unit",
              "batch",
              "replicate",
              "is_control"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Standardized columns uniquely identifying records. Include cell_id; sample_id; plate_id+well_id; or plate_id+well_id+site_id according to experiment_level."
        },
        "format": {
          "type": "string",
          "enum": [
            "auto",
            "csv",
            "tsv",
            "xlsx",
            "parquet",
            "h5ad_obs"
          ],
          "description": "Default auto; CSV/TSV also support gzip. H5AD reads obs only."
        },
        "sheet_name": {
          "type": "string",
          "minLength": 1,
          "description": "XLSX sheet name; default first sheet, invalid for other formats."
        },
        "constants": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "perturbation",
              "perturbation_type",
              "cell_id",
              "sample_id",
              "plate_id",
              "well_id",
              "site_id",
              "cell_type",
              "dose",
              "dose_unit",
              "time",
              "time_unit",
              "batch",
              "replicate",
              "is_control"
            ]
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Explicit standard field constants, e.g. dose_unit=uM. Cannot overlap field_map. No units or biological meaning are inferred."
        },
        "control_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Exact perturbation labels denoting controls. Must match at least one row; must agree with any mapped is_control column."
        },
        "duplicate_keys": {
          "type": "string",
          "enum": [
            "error",
            "collapse_identical"
          ],
          "description": "Default error. collapse_identical only collapses identical standardized rows; conflicting annotations always fail."
        },
        "missing_optional": {
          "type": "string",
          "enum": [
            "preserve",
            "error"
          ],
          "description": "Default preserve: optional blanks become null with counts. Keys, perturbation and provided is_control must not be missing."
        },
        "preview_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Number of actual standardized records returned for preview; default 5."
        },
        "metadata_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "description": "Unique metadata artifact ID; auto-generated when omitted."
        },
        "missing_perturbation": {
          "type": "string",
          "enum": [
            "error",
            "drop_rows"
          ],
          "description": "Default error. Explicit drop_rows removes records whose perturbation label is missing and reports count; never infers controls or treatment."
        }
      }
    },
    "return_schema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "data",
            "warnings"
          ],
          "properties": {
            "status": {
              "const": "success"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metadata_ref",
                "table_path",
                "metadata_id",
                "experiment_level",
                "n_source_rows",
                "n_rows",
                "fields",
                "association_keys",
                "n_perturbations",
                "n_controls",
                "preview"
              ],
              "properties": {
                "metadata_ref": {
                  "type": "string"
                },
                "table_path": {
                  "type": "string"
                },
                "metadata_id": {
                  "type": "string"
                },
                "experiment_level": {
                  "enum": [
                    "cell",
                    "sample",
                    "well",
                    "field"
                  ]
                },
                "n_source_rows": {
                  "type": "integer",
                  "minimum": 1
                },
                "n_rows": {
                  "type": "integer",
                  "minimum": 1
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "association_keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "n_perturbations": {
                  "type": "integer",
                  "minimum": 1
                },
                "n_controls": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "preview": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "error_code"
          ],
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "type": "string"
            },
            "error_code": {
              "type": "string"
            }
          }
        }
      ]
    },
    "requires_local_input": true,
    "cacheable": false
  }
]
