  {
    "name": "scDrugMap_get_expression",
    "type": "ScDrugMapQueryTool",
    "description": "Read a bounded gene-by-cell slice of author-deposited values in requested order from either matrix orientation. Unknown IDs are errors. Missing/nonfinite source values are JSON null. This operation does not normalize the matrix.",
