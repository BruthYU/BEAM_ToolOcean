      "operation": "expression"
    },
    "requires_local_input": false,
    "cacheable": false,
    "parameter": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "type": "string",
          "description": "Qualified scDrugMap group ID from list_datasets (e.g. external:Data20)."
        },
        "genes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "description": "Exact source gene IDs."
        },
        "cell_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "description": "Exact scDrugMap cell IDs within this group."
        },
        "operation": {
          "type": "string",
          "enum": [
            "expression"
          ],
          "default": "expression",
          "description": "Fixed backend operation."
        }
      },
      "required": [
        "dataset_id",
        "genes",
        "cell_ids"
      ],
      "additionalProperties": false
    },
    "return_schema": {
